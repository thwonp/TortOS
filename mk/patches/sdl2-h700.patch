+
+/* Mali fbdev EGL video driver: one fullscreen window on /dev/fb0, drawn by
+ * the ARM Mali blob's fbdev winsys, whose native window is just a size.
+ * Altered source (plorpOS, H700 on BaseOS), modelled on the vivante driver. */
+
+#include "../../SDL_internal.h"
+
+#if defined(SDL_VIDEO_DRIVER_MALI) && defined(SDL_VIDEO_OPENGL_EGL)
+
+#include <fcntl.h>
+#include <linux/fb.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#include "../SDL_sysvideo.h"
+#include "../SDL_egl_c.h"
+#include "../../events/SDL_keyboard_c.h"
+#include "../../events/SDL_mouse_c.h"
+
+#ifdef SDL_INPUT_LINUXEV
+#include "../../core/linux/SDL_evdev.h"
+#endif
+
+/* The Mali fbdev winsys reads its native window as this struct. */
+struct mali_native_window
+{
+    unsigned short width;
+    unsigned short height;
+};
+
+typedef struct SDL_WindowData
+{
+    struct mali_native_window native;
+    EGLSurface egl_surface;
+} SDL_WindowData;
+
+static int MALI_VideoInit(_THIS)
+{
+    struct fb_var_screeninfo v;
+    SDL_DisplayMode mode;
+    int fd = open("/dev/fb0", O_RDONLY | O_CLOEXEC);
+
+    if (fd < 0) {
+        return SDL_SetError("mali: can't open /dev/fb0");
+    }
+    if (ioctl(fd, FBIOGET_VSCREENINFO, &v) < 0) {
+        close(fd);
+        return SDL_SetError("mali: FBIOGET_VSCREENINFO failed");
+    }
+    close(fd);
+
+    SDL_zero(mode);
+    mode.w = v.xres;
+    mode.h = v.yres;
+    mode.format = v.bits_per_pixel == 16 ? SDL_PIXELFORMAT_RGB565 : SDL_PIXELFORMAT_ARGB8888;
+    mode.refresh_rate = 60;
+    if (SDL_AddBasicVideoDisplay(&mode) < 0) {
+        return -1;
+    }
+#ifdef SDL_INPUT_LINUXEV
+    if (SDL_EVDEV_Init() < 0) {
+        return -1;
+    }
+#endif
+    return 0;
+}
+
+static void MALI_VideoQuit(_THIS)
+{
+#ifdef SDL_INPUT_LINUXEV
+    SDL_EVDEV_Quit();
+#endif
+}
+
+static int MALI_SetDisplayMode(_THIS, SDL_VideoDisplay *display, SDL_DisplayMode *mode)
+{
+    return 0;
+}
+
+static int MALI_GLES_LoadLibrary(_THIS, const char *path)
+{
+    return SDL_EGL_LoadLibrary(_this, path, EGL_DEFAULT_DISPLAY, 0);
+}
+
+static int MALI_CreateWindow(_THIS, SDL_Window *window)
+{
+    SDL_DisplayMode *mode = &SDL_GetDisplayForWindow(window)->desktop_mode;
+    SDL_WindowData *data;
+
+    if (!_this->egl_data && SDL_GL_LoadLibrary(NULL) < 0) {
+        return -1;
+    }
+    data = (SDL_WindowData *)SDL_calloc(1, sizeof(*data));
+    if (!data) {
+        return SDL_OutOfMemory();
+    }
+    window->driverdata = data;
+
+    /* Always the whole panel: the winsys has no notion of position. */
+    window->x = 0;
+    window->y = 0;
+    window->w = mode->w;
+    window->h = mode->h;
+    window->flags |= SDL_WINDOW_FULLSCREEN | SDL_WINDOW_OPENGL;
+    data->native.width = mode->w;
+    data->native.height = mode->h;
+
+    data->egl_surface = SDL_EGL_CreateSurface(_this, (NativeWindowType)&data->native);
+    if (data->egl_surface == EGL_NO_SURFACE) {
+        return SDL_SetError("mali: can't create EGL surface");
+    }
+    SDL_SetMouseFocus(window);
+    SDL_SetKeyboardFocus(window);
+    return 0;
+}
+
+static void MALI_DestroyWindow(_THIS, SDL_Window *window)
+{
+    SDL_WindowData *data = window->driverdata;
+
+    if (data) {
+        if (data->egl_surface != EGL_NO_SURFACE) {
+            SDL_EGL_MakeCurrent(_this, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+            SDL_EGL_DestroySurface(_this, data->egl_surface);
+        }
+        SDL_free(data);
+        window->driverdata = NULL;
+    }
+}
+
+static void MALI_PumpEvents(_THIS)
+{
+#ifdef SDL_INPUT_LINUXEV
+    SDL_EVDEV_Poll();
+#endif
+}
+
+static SDL_EGL_CreateContext_impl(MALI)
+static SDL_EGL_SwapWindow_impl(MALI)
+static SDL_EGL_MakeCurrent_impl(MALI)
+
+static void MALI_Destroy(SDL_VideoDevice *device)
+{
+    SDL_free(device);
+}
+
+static SDL_VideoDevice *MALI_Create(void)
+{
+    SDL_VideoDevice *device;
+
+    if (access("/dev/mali0", F_OK) != 0) {
+        return NULL;
+    }
+    device = (SDL_VideoDevice *)SDL_calloc(1, sizeof(SDL_VideoDevice));
+    if (!device) {
+        SDL_OutOfMemory();
+        return NULL;
+    }
+    device->free = MALI_Destroy;
+    device->VideoInit = MALI_VideoInit;
+    device->VideoQuit = MALI_VideoQuit;
+    device->SetDisplayMode = MALI_SetDisplayMode;
+    device->CreateSDLWindow = MALI_CreateWindow;
+    device->DestroyWindow = MALI_DestroyWindow;
+    device->PumpEvents = MALI_PumpEvents;
+    device->GL_LoadLibrary = MALI_GLES_LoadLibrary;
+    device->GL_GetProcAddress = SDL_EGL_GetProcAddress;
+    device->GL_UnloadLibrary = SDL_EGL_UnloadLibrary;
+    device->GL_CreateContext = MALI_GLES_CreateContext;
+    device->GL_MakeCurrent = MALI_GLES_MakeCurrent;
+    device->GL_SetSwapInterval = SDL_EGL_SetSwapInterval;
+    device->GL_GetSwapInterval = SDL_EGL_GetSwapInterval;
+    device->GL_SwapWindow = MALI_GLES_SwapWindow;
+    device->GL_DeleteContext = SDL_EGL_DeleteContext;
+    return device;
+}
+
+VideoBootStrap MALI_bootstrap = {
+    "mali",
+    "Mali fbdev EGL video driver",
+    MALI_Create,
+    NULL /* no ShowMessageBox implementation */
+};
+
+#endif /* SDL_VIDEO_DRIVER_MALI && SDL_VIDEO_OPENGL_EGL */
